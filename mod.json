{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "wntry4702.ticksaver",
  "name": "TickSaver",
  "version": "1.0.0",
  "developer": "TickSaver",
  "description": "Timing analysis and input correction tools.",
  "dependencies": {
    "geode.node-ids": ">=v1.23.3"
  },
  "settings": {
    "analysis-range": {
      "name": "Analysis Range",
      "description": "Number of ticks to check before and after the original timing.",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 12,
      "control": {
        "arrows": true,
        "slider": true,
        "slider-step": 1,
        "input": true
      }
    }
  }
}
